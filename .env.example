# Copy to .env before running docker compose up.

# PostgreSQL
POSTGRES_DB=agendamento
POSTGRES_USER=agendamento
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
# Spring profile: "demo" seeds the demo business, leave empty for a clean database.
SPRING_PROFILES_ACTIVE=demo
# HMAC key for signing JWTs. Must be at least 32 bytes.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_EXPIRATION_MINUTES=480
# Gap between two offered slots, in minutes.
SLOT_INTERVAL_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
